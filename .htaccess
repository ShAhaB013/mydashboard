Header set X-Robots-Tag "noindex, nofollow"

# Prevent directory listing
Options -Indexes

# ─── Themed error pages (see error.php) ───────────────────────
ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500
ErrorDocument 503 /error.php?code=503


# ─── Clean URLs (without .php extension) ──────────────────────────────
# Standard approach: external 301 to strip .php (avoids duplicate content)
# + internal serving of the extensionless version. api.php is left untouched
# since it's called programmatically with ?action= (must not get a 301).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ─── Force HTTPS ─────────────────────────────────────────────
  # Every HTTP request is redirected to the HTTPS version (301). The
  # X-Forwarded-Proto condition is for compatibility with TLS terminators (LiteSpeed/proxy).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /admin and /admin/ → admin.php (admin panel entry point)
  # The backend folder is now named app/ (not admin/) and is fully denied. This
  # rule explicitly maps the /admin URL to admin.php and preserves query strings
  # like ?page=users via QSA (the 301 redirect below excludes admin.php).
  RewriteRule ^admin/?$ admin.php [L,QSA]

  # index.php (with/without query) → /
  RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
  RewriteRule ^ / [R=301,L]

  # foo.php → /foo  (except api.php, admin.php and error.php)
  # admin.php and api.php are called programmatically with ?api= / ?action=
  # (JSON POSTs). A 301 redirect would break them (POST→GET + body dropped)
  # causing "server connection error" in the panel; so both are excluded.
  # error.php is excluded too since it's called with ?code= via ErrorDocument.
  RewriteCond %{THE_REQUEST} !\s/+(api|admin|error)\.php [NC]
  RewriteCond %{THE_REQUEST} \s/+([^.\s?/]+)\.php[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /foo → foo.php  (only if foo.php actually exists)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>


<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Buggy old browsers
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  Header append Vary Accept-Encoding
</IfModule>


<IfModule mod_expires.c>
  ExpiresActive On

  
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"

  
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"

  
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/avif              "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/gif               "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"

  ExpiresByType application/json        "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: after forcing HTTPS, this makes the browser always use HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Restrict sensitive browser APIs this app doesn't use.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Note: the CSP header isn't set here because it needs a per-request nonce,
  # so it's sent from PHP instead (bootstrap.php → csp_nonce()). Migrate to enforcing there.
</IfModule>

# Sensitive files: dotfiles, database dumps, archives/backups, config, logs ...
<FilesMatch "(^\.|\.(sql|md|json|log|ini|zip|tar|gz|tgz|rar|7z|bak|old|swp|env|lock|sqlite|db|conf|dist)$)">
  Require all denied
</FilesMatch>

# PHP files that are not production entry points: shared includes + config +
# the dev server router (dev-router.php is only for php -S and must not be served on hosting)
<FilesMatch "^(dash_config|bootstrap|version|dev-router)\.php$">
  Require all denied
</FilesMatch>


# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_flag log_errors On
   php_value max_execution_time 60
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 1024M
   php_value post_max_size 100M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 100M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_flag log_errors On
   php_value max_execution_time 60
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 1024M
   php_value post_max_size 100M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 100M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit